# Copy to zoom-app/.env (gitignored). Values come from the Zoom App Marketplace build page.

# Zoom App credentials (Marketplace → Develop → Build App → General Apps)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Public HTTPS URL that the Zoom client loads (an ngrok tunnel to this server in development).
# Home URL in the Marketplace = PUBLIC_URL ; OAuth Redirect URL = PUBLIC_URL/auth
PUBLIC_URL=https://your-tunnel.ngrok-free.app

# The review backend this app logs question/canary events to (interview_review.cli serve).
BACKEND_URL=http://localhost:8000

PORT=3400

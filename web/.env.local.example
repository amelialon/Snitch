# TEMPLATE — copy to web/.env.local and fill in. Values here ship to the browser, so NEVER put
# secret API keys here. A room URL is fine (it is meant to be shared); an API key is not.

NEXT_PUBLIC_API_URL=http://localhost:8000

# A Daily room URL for the live interview room (https://yourteam.daily.co/room-name).
# Without it, the live room shows a config notice. NOT a Zoom link.
NEXT_PUBLIC_DAILY_ROOM_URL=

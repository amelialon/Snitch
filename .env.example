# TEMPLATE — copy to backend/.env and fill in. Never put real keys in this file (it is committed).
# With NOTHING set, the app runs fully offline (upload a transcript .json, rule-based analyst).

# --- storage: local (disk) or firebase ---
STORE=local
DATA_DIR=data
# STORE=firebase
# FIREBASE_CREDENTIALS=./firebase-service-account.json   # path to the key FILE (get from a teammate)
#   on a host with only env vars (Railway), paste the key file's JSON as the value instead
# FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# --- transcription (audio/video -> words). Without it, upload a transcript .json ---
# ASSEMBLYAI_API_KEY=

# --- OpenAI: powers BOTH the analyst (segmentation/depth/write-ups) AND CV consistency ---
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# --- AI-text signal (GPTZero). Without it, that content signal is reported as skipped ---
# GPTZERO_API_KEY=

# --- web app origin for CORS (comma-separated; add the Vercel URL when deployed) ---
WEB_ORIGIN=http://localhost:3000
